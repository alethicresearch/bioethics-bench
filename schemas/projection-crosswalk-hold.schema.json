{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bioethicsbench.com/schemas/projection-crosswalk-hold.schema.json",
  "title": "Bioethics Bench projection crosswalk hold",
  "description": "A reviewed decision not to force a historical executable projection onto the current neutral candidate universe when one-to-one Policy identity or source-role fidelity is not defensible.",
  "type": "object",
  "required": [
    "review_id",
    "review_version",
    "case_family_id",
    "candidate_universe_resource",
    "source_record_ids",
    "status",
    "reason_codes",
    "issues",
    "next_action",
    "reviewed_at"
  ],
  "properties": {
    "review_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "review_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "case_family_id": {
      "type": "string",
      "pattern": "^m[0-9]{3}$"
    },
    "candidate_universe_resource": {
      "type": "string",
      "minLength": 1
    },
    "source_record_ids": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "uniqueItems": true
    },
    "status": {
      "const": "hold"
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "combined-neutral-positions",
          "split-neutral-position",
          "source-role-mismatch",
          "granularity-mismatch",
          "candidate-not-represented",
          "supersession-needed",
          "provenance-review-needed",
          "other"
        ]
      }
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_role", "source_candidate_id", "related_neutral_candidate_ids", "explanation"],
        "properties": {
          "source_role": { "enum": ["public", "expert", "framework"] },
          "source_candidate_id": { "type": "string", "pattern": "^(pub|exp|fw)[0-9]+$" },
          "related_neutral_candidate_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^c[0-9]{2}$" },
            "uniqueItems": true
          },
          "explanation": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": false
}
