{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bioethicsbench.com/schemas/manifest.schema.json",
  "title": "Bioethics Bench manifest",
  "type": "object",
  "required": [
    "manifest_version",
    "release_id",
    "records",
    "created_at",
    "content_hash_algorithm"
  ],
  "properties": {
    "manifest_version": {
      "type": "string"
    },
    "release_id": {
      "type": "string"
    },
    "release_status": {
      "enum": [
        "development",
        "release-candidate",
        "released"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "qccs_protocol_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "record_id",
          "version",
          "content_hash",
          "path"
        ],
        "properties": {
          "record_id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "content_hash": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "collection": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "qccs_protocol_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "qccs_protocol_hash": {
      "type": [
        "string",
        "null"
      ],
      "description": "SHA-256 of the canonical QCCS specification the release's results were produced under."
    },
    "scoring_mode": {
      "type": [
        "string",
        "null"
      ],
      "description": "Which scoring operationalization. conv+ and conv\u00b1 are different measurements, not display scales."
    },
    "content_hash_algorithm": {
      "type": "string",
      "const": "jcs-sha256",
      "description": "See docs/VERSIONING.md. Fixed so two implementations agree."
    },
    "schema_versions": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
