{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bioethicsbench.com/schemas/projection-manifest.schema.json",
  "title": "Bioethics Bench SACRE projection manifest",
  "description": "A declared analysis view over one neutral case-family candidate universe. Projection role assignment is separate from candidate provenance. Historical crosswalks additionally record how each represented source-role candidate maps to neutral Policy identity.",
  "type": "object",
  "required": [
    "projection_id",
    "projection_version",
    "case_family_id",
    "candidate_universe_resource",
    "projection_type",
    "claim_scope",
    "role_assignments",
    "aggregation"
  ],
  "properties": {
    "projection_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "projection_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "case_family_id": {
      "type": "string",
      "pattern": "^m[0-9]{3}$"
    },
    "candidate_universe_resource": {
      "type": "string",
      "minLength": 1
    },
    "projection_type": {
      "enum": [
        "source-grounded",
        "expanded",
        "matched-study",
        "demonstration",
        "direct-grounding"
      ]
    },
    "claim_scope": {
      "type": "string",
      "minLength": 1,
      "description": "What inferences results from this projection may support. Source-grounded and expanded projections must not share an undifferentiated claim scope."
    },
    "as_of_date": {
      "type": ["string", "null"],
      "format": "date"
    },
    "jurisdiction_context": {
      "type": ["string", "null"]
    },
    "role_assignments": {
      "type": "object",
      "required": ["public", "expert", "framework"],
      "properties": {
        "public": { "$ref": "#/$defs/ids" },
        "expert": { "$ref": "#/$defs/ids" },
        "framework": { "$ref": "#/$defs/ids" }
      },
      "additionalProperties": false
    },
    "aggregation": {
      "enum": ["sum", "mean"]
    },
    "source_record_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "uniqueItems": true,
      "description": "Optional lineage to existing executable record(s). A historical crosswalk pins the matched concise/detailed pair."
    },
    "source_candidate_crosswalk": {
      "type": "array",
      "items": { "$ref": "#/$defs/crosswalk" },
      "description": "Explicit mapping from each historical source-role candidate to neutral Policy identity. The same neutral Policy may appear in different evidence roles when independently supported; within one source role each historical candidate remains distinct."
    },
    "review_status": {
      "enum": ["approved-editorial-crosswalk", "approved-new-projection"]
    },
    "reviewed_at": {
      "type": ["string", "null"],
      "format": "date"
    },
    "notes": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^c[0-9]{2}$" },
      "uniqueItems": true
    },
    "crosswalk": {
      "type": "object",
      "required": ["source_role", "source_candidate_id", "neutral_candidate_id", "relation"],
      "properties": {
        "source_role": { "enum": ["public", "expert", "framework"] },
        "source_candidate_id": { "type": "string", "pattern": "^(pub|exp|fw)[0-9]+$" },
        "neutral_candidate_id": { "type": "string", "pattern": "^c[0-9]{2}$" },
        "relation": { "const": "materially-equivalent" },
        "note": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}
